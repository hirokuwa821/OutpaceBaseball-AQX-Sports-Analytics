# Optional integrations. Copy this file to .env and fill in only the services you use.
# Never commit .env or put AWS credentials in this file.

# AWS integrations (optional). Use an IAM role or the standard AWS credential chain.
AWS_REGION=
S3_BUCKET=your-private-s3-bucket
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0

# Optional RevenueCat integration. Keep secret keys private.
REVENUECAT_API_KEY=
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_PRODUCT_ID=
REVENUECAT_OFFERING_ID=
REVENUECAT_ENVIRONMENT=sandbox
REVENUECAT_PURCHASE_LINK_URL=
